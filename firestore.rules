rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = wahi ek account jiska uid settings/admin me likha hai (pehli baar site se banta hai).
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/settings/admin)
          && get(/databases/$(database)/documents/settings/admin).data.uid == request.auth.uid;
    }
    function signedIn() { return request.auth != null; }

    // Products: sab dekh sakte hain, sirf admin badal sakta hai.
    // Order ke time customer sirf "stock" ghata sakta hai (badha nahi sakta).
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                    && request.resource.data.stock is number
                    && request.resource.data.stock >= 0
                    && request.resource.data.stock <= resource.data.stock;
    }

    // Site settings, about, filters, banners: sab dekh sakte hain, sirf admin badal sakta hai
    match /settings/{doc} { allow read: if true; allow write: if isAdmin(); }
    // Pehli baar admin banane ke liye: sirf create (ek hi baar), badal nahi sakta
    match /settings/admin { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; }
    match /banners/{doc}  { allow read: if true; allow write: if isAdmin(); }

    // Coupons: code pata ho to check kar sakte hain, list sirf admin dekh sakta hai
    match /coupons/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Customers: admin sab dekhta hai, customer sirf apna profile
    match /customers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Orders + Bills: payment ke baad banta hai. Delete kisi ko nahi (permanent record).
    match /orders/{id} {
      allow create: if request.resource.data.paymentStatus == 'paid'
                    && request.resource.data.total is number
                    && request.resource.data.items is list
                    && (request.resource.data.uid == 'guest'
                        || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
